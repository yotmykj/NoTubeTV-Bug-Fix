(function() {
    if (window.__notube_shorts_adblock_initialized) return;
    window.__notube_shorts_adblock_initialized = true;

    const cleanShortsAds = () => {
        try {
            // 1. Поиск и полное удаление рекламных роликов и элементов в ленте Shorts (Leanback TV)
            const reelAds = document.querySelectorAll(
                'ytlr-reel-ad-item-renderer, ' +
                '[is-ad-item], ' +
                '[class*="reel-ad"], ' +
                '[class*="shorts-ad"], ' +
                'ytlr-ad-badge'
            );

            reelAds.forEach(ad => {
                const container = ad.closest('ytlr-reel-item-renderer') || ad;
                if (container && container.parentNode) {
                    container.remove();
                }
            });

            // 2. Если рекламный Short всё же начал воспроизведение — мгновенно проматываем его до конца
            const reelVideo = document.querySelector('ytlr-reel-video-renderer video, [class*="reel"] video');
            const adIndicator = document.querySelector('ytlr-reel-ad-item-renderer, [class*="ad-showing"]');

            if (reelVideo && adIndicator) {
                reelVideo.muted = true;
                if (reelVideo.duration && !isNaN(reelVideo.duration)) {
                    reelVideo.currentTime = reelVideo.duration;
                }
            }
        } catch (e) {}
    };

    // Проверка каждые 100мс для моментальной фильтрации Shorts
    setInterval(cleanShortsAds, 100);

    const observer = new MutationObserver(cleanShortsAds);
    if (document.body) {
        observer.observe(document.body, { childList: true, subtree: true });
    } else {
        window.addEventListener('DOMContentLoaded', () => {
            observer.observe(document.body, { childList: true, subtree: true });
        });
    }
})();
