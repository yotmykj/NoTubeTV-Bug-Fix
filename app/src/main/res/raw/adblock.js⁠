(function() {
    if (window.__notube_shorts_adblock_initialized) return;
    window.__notube_shorts_adblock_initialized = true;

    const cleanShortsAds = () => {
        try {
            // 1. Поиск и полное удаление рекламных роликов и элементов в ленте Shorts (Leanback TV)
            const reelAds = document.querySelectorAll(
                'ytlr-reel-ad-item-renderer, ' +
                '[is-ad-item], ' +
                '[class*="reel-ad"], ' +
                '[class*="shorts-ad"], ' +
                'ytlr-ad-badge'
            );

            reelAds.forEach(ad => {
                const container = ad.closest('ytlr-reel-item-renderer') || ad;
                if (container && container.parentNode) {
                    container.remove();
                }
            });

            // 2. Если рекламный Short всё же начал воспроизведение — мгновенно проматываем его до конца
            const reelVideo = document.querySelector('ytlr-reel-video-renderer video, [class*="reel"] video');
            const adIndicator = document.querySelector('ytlr-reel-ad-item-renderer, [class*="ad-showing"]');

            if (reelVideo && adIndicator) {
                reelVideo.muted = true;
                if (reelVideo.duration && !isNaN(reelVideo.duration)) {
                    reelVideo.currentTime = reelVideo.duration;
                }
            }
        } catch (e) {}
    };

    // Проверка каждые 100мс для моментальной фильтрации Shorts
    setInterval(cleanShortsAds, 100);

    const observer = new MutationObserver(cleanShortsAds);
    if (document.body) {
        observer.observe(document.body, { childList: true, subtree: true });
    } else {
        window.addEventListener('DOMContentLoaded', () => {
            observer.observe(document.body, { childList: true, subtree: true });
        });
    }
// ===== NoTube+ Shorts AdBlock =====
(function () {
    if (window.__notubeShortsAdBlock) return;
    window.__notubeShortsAdBlock = true;

    function blockShortsAds() {
        try {
            // Удаление рекламных элементов Shorts
            document.querySelectorAll(`
                ytlr-reel-ad-item-renderer,
                [is-ad-item],
                [class*="reel-ad"],
                [class*="shorts-ad"],
                ytlr-ad-badge
            `).forEach(el => el.remove());

            // Если проигрывается рекламный Shorts — пропускаем
            const video = document.querySelector("video");
            const isAd =
                document.querySelector("ytlr-reel-ad-item-renderer") ||
                document.querySelector('[class*="ad-showing"]');

            if (video && isAd && video.duration) {
                video.muted = true;
                video.currentTime = video.duration;
            }

            // Удаляем рекламные бейджи
            document.querySelectorAll('[aria-label*="Реклама"], [aria-label*="Ad"]')
                .forEach(el => el.remove());

        } catch (e) {}
    }

    // Первичная проверка
    blockShortsAds();

    // Следим за изменениями страницы
    new MutationObserver(blockShortsAds).observe(document.documentElement, {
        childList: true,
        subtree: true
    });

    // Дополнительная проверка
    setInterval(blockShortsAds, 300);
})();
